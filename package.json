{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-spend",
  "version": "1.0.0",
  "description": "Context window bar and total session spend (orchestrator + all nested subagents) with per-agent, per-model and per-subagent breakdowns in the OpenCode sidebar.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "cost",
    "spend",
    "usage",
    "subagents",
    "context",
    "context-window",
    "sidebar"
  ],
  "license": "MIT",
  "author": "Joe Woodward",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/jwoodwardgl/opencode-spend.git"
  },
  "homepage": "https://gitlab.com/jwoodwardgl/opencode-spend",
  "bugs": {
    "url": "https://gitlab.com/jwoodwardgl/opencode-spend/-/issues"
  },
  "exports": {
    "./tui": "./tui.tsx"
  },
  "files": [
    "tui.tsx",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=2.0.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun run test:render",
    "test:render": "bun test --preload @opentui/solid/preload ./test/render/sidebar.render.ts && bun test --preload ./test/render/npm-preload.ts ./test/render/sidebar.render.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.9",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.16",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/bun": "~1.3.14",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.6.0"
  }
}
